# Adcontact environment variables
# Copy this file to .env.local and fill in the values

# ─── Application ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.adcontact.se

# ─── Media (/media proxy: local -> R2 -> Orderland fallback) ────
# PRIMARY source for all catalogue images & PDFs: the Cloudflare R2 bucket.
# If this is missing/wrong, every product image breaks. In production point it
# at an R2 custom domain (the *.r2.dev address is rate-limited).
R2_MEDIA_ORIGIN=https://pub-xxxxxxxxxxxx.r2.dev

# Fallback for older /media/... catalogue paths not yet copied into R2:
# /media/catalog/product, /media/catalog/category, /media/amfile/files.
ORDERLAND_MEDIA_ORIGIN=https://adcgam.hemsida.eu
# Optional secondary fallback origin.
ORDERLAND_MEDIA_FALLBACK_ORIGIN=

# ─── Forms (RFQ / quote) — Web3Forms (client-side) ──────────────
# Forms submit from the BROWSER to Web3Forms (its free tier is browser-only),
# which emails them to the inbox set in the Web3Forms dashboard. This key is
# public by design (Web3Forms keys are rate-limited and only email your inbox),
# so it uses the NEXT_PUBLIC_ prefix to be readable in the browser.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Captcha = hCaptcha via Web3Forms' shared key — no account or keys needed
# (site key is baked into src/lib/web3forms.ts). No env var required.

# (Legacy / unused.)
# WEB3FORMS_ACCESS_KEY=            server-side; Web3Forms free tier blocks server POSTs
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=  Turnstile isn't a Web3Forms option
# TURNSTILE_SECRET_KEY=
# RESEND_API_KEY=re_xxxxxxxxxxxx   (only if switching to server-side Resend delivery)

# ─── CRM / Backend (optional) ───────────────────────────────────
# Airtable
# AIRTABLE_API_KEY=patxxxxxxxxxxxxxxxx
# AIRTABLE_BASE_ID=appxxxxxxxxxxxxxxxx
# AIRTABLE_TABLE_ID=tblxxxxxxxxxxxxxxxx

# HubSpot
# HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxxxxxx
# HUBSPOT_PORTAL_ID=12345678

# Supabase
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Analytics — Google Analytics 4, consent-gated ──────────────
# GA4 Measurement ID (Google Analytics -> Admin -> Data streams). GA only loads
# after the visitor accepts cookies ("Accept all"); nothing fires without consent.
# Leave unset and no analytics loads at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Outlet checkout — Stripe (2026-09) ──────────────────────────
# Server-side only, never NEXT_PUBLIC_ (Checkout Sessions are created
# server-side; the browser is just redirected to the URL Stripe returns).
# Sandbox/test key first (sk_test_...) — switch to a live key (sk_live_...)
# only once the integration is fully tested AND the returns-policy question
# for individual buyers is resolved. See the outlet-checkout memory playbook.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Generated when the webhook endpoint is registered in the Stripe dashboard
# (or via `stripe listen` for local dev) — not needed until that step.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── Product database (outlet live inventory) ────────────────────
# Vercel Postgres — holds sku -> quantity remaining for the outlet checkout,
# since the outlet catalogue itself is static JSON baked in at build time
# and can't be decremented live without this.
DATABASE_URL=postgresql://user:pass@host:5432/adcontact
